  "private": true,
  "description": "Pi setup package for git distribution",
  "keywords": [
    "pi-package"
  ],
  "dependencies": {
    "pi-annotations": "latest",
    "pi-system-prompt": "latest"
  },
  "bundledDependencies": [
    "pi-annotations",
    "pi-system-prompt"
  ],
  "pi": {
